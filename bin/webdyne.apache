#!/usr/bin/env perl

#
#  This file is part of WebDyne.
#
#  This software is copyright (c) 2026 by Andrew Speer <andrew.speer@isolutions.com.au>.
#
#  This is free software; you can redistribute it and/or modify it under
#  the same terms as the Perl 5 programming language system itself.
#
#  Full license text is available at:
#
#  <http://dev.perl.org/licenses/>
#


#  Pragma
#
use strict;
use vars   qw($VERSION);
use warnings;


#  External modules
#
use Cwd qw(fastcwd);
use Config;
use File::Basename;
use File::Spec;
use File::Temp qw(tempdir);
use IO::File;
use Fcntl;
use Getopt::Long;
use POSIX qw(pause);


#  WebDyne modules
#
use WebDyne::Constant;
use WebDyne::Util;


#  Version information
#
$VERSION='2.088_630';


#  Check for supporting modules
#
BEGIN {
    eval ("require Apache2::Build; 1") || do {
        if ($@=~/Module::CoreList/i) {
            print STDERR ("Apache2::Build found but needs rebuild/reinstall of Module::CoreList. Please install/upgrade Module::CoreList\n");
            exit 1;
        }
    };
    my @missing;
    for my $module (qw(Apache2::Build Apache::Test Module::CoreList)) {
        eval "require $module; 1" or push @missing, $module;
    }
    if (@missing) {
        printf STDERR ("Please install missing CPAN modules (you may need mod_perl-devel packages also): %s \n", join(', ', @missing));
        exit 1;
    }

}


#  Run main
#
exit ${&main(\@ARGV) || die errdump()};


#==================================================================================================


sub main {


    #  Get argv array ref
    #
    my $argv_ar=shift();


    #  Defaults
    #
    my %opt=(
        index       => 1,
        root        => fastcwd(),
        keep_tmp    => 0,
        port        => ($^O eq 'darwin') ? 5001 : 5000,
        %{do(glob(sprintf('~/.%s.opt', basename(__FILE__)))) || {}}
    );


    #  Process
    #
    Getopt::Long::Configure('pass_through');
    GetOptions(
        \%opt,
        'index!',
        'root|docroot|doc_root|document_root=s',
        'port=s',
        'keep_tmp!',
        'test!',
        'dump_postamble|dump-postamble',
        'argv=s',
        'help|?'
    ) || return err('bad options');


    #  Last argument is root directory
    #
    if (@{$argv_ar} && $argv_ar->[-1] !~ /^--?/) {
        $opt{'root'} = pop @{$argv_ar};
    }
    $opt{'root'} ||=($ENV{'DOCUMENT_ROOT'} || fastcwd());


    #  File or dir ? If file Apache won't like as DOCUMENT_ROOT so need to set
    #  as Perl environment var in httpd.conf (later) and handle differently
    #
    if (-f ($opt{'root'}=File::Spec->rel2abs($opt{'root'}))) {
        $opt{'root_pn'}=$opt{'root'};
        $opt{'root'}=dirname($opt{'root'});
    }
    elsif($opt{'test'}) {
        $opt{'root_pn'}=$WEBDYNE_DEFAULT_TEST_FN;
    }


    #  Indexing. 1 for enable with internal, string for some other indexing file
    #
    if ($opt{'index'} eq '1') {
        $opt{'index'}=$WEBDYNE_DEFAULT_INDEX_FN;
    }
    
    
    #  Startup server
    #
    printf("Starting server on localhost (127.0.0.1), port: %s\n", $opt{'port'});
    my $runner=request_mod_perl_startup(\%opt) || return err();


    #  Shutdown on signal
    #
    my $shutdown_cr=sub { request_mod_perl_shutdown($runner); exit 0 };
    $SIG{'INT'}=$shutdown_cr;
    $SIG{'TERM'}=$shutdown_cr;


    #  Block forever
    #
    while (1) {
        pause();
    }

}


sub request_mod_perl_startup {


    #  Startup Apache test instance
    #
    my $opt_hr=shift();


    #  Server root tmpdir
    #
    my $svr_root_dn=tempdir(
        'webdyne_apache_XXXXXXXX',
        TMPDIR  => 1,
        CLEANUP => !$opt_hr->{'keep_tmp'},
    );


    #  Create webdyne cache there
    #
    mkdir (my $cache_dn=File::Spec->catdir($svr_root_dn, 'cache'));
    $ENV{'WEBDYNE_CACHE_DN'}=$cache_dn;


    #  Start Apache server. Mask warnings about duplicate options
    #
    local $SIG{__WARN__}=sub {
        return if $_[0] =~ /Duplicate specification/;
        CORE::warn @_;
    };


    #  Don't need ulimit
    #
    $ENV{'APACHE_TEST_ULIMIT_SET'}++;
    

    #  Don't need index.html generated
    #
    no warnings qw(once redefine);
    *Apache::TestConfig::generate_index_html=sub {};


    #  Don't want include libraries changes, stuf this out
    #
    *Apache::TestConfig::configure_startup_pl=sub {};


    #  Runner object init
    #
    require Apache::TestRunPerl;
    my $runner = Apache::TestRunPerl->new() ||
        return err('unable to create Apache::TestRunPerl instance');


    #  Get postamble with WebDyne config
    #
    my $postamble=request_mod_perl_postamble($opt_hr->{'root'}, $opt_hr);


    #  Start httpd in one-process mode
    #
    my @argv=(
        '-port'         => $opt_hr->{'port'},
        '-serverroot'   => $svr_root_dn,
        '-documentroot' => $opt_hr->{'root'},
        '-postamble'    => $postamble,
        '-one-process',
        '-start-httpd'
    );


    #  Now start. Will die if can't start
    #
    $runner->run(@argv);


    #  Done
    #
    return $runner;

}


sub request_mod_perl_shutdown {


    #  Shut down Apache server
    #
    my $runner=shift();
    return unless $runner;


    $runner->{'server'}->stop() if $runner->{'server'};

}


sub request_mod_perl_postamble {


    #  Get all WEBDYNE_CONF env vars and setup config file
    #
    my ($document_root, $opt_hr)=@_;
    $document_root=File::Spec->rel2abs($document_root);


    #  Need to work out if stderr writable. If not need to use alternate log file (prob running in container)
    #
    my $stderr_fn='/dev/stderr';
    my $stdout_fn='/dev/stdout';
    if (! open(my $fh, '>>', $stderr_fn)) {

        #  Not writable, probably running under docker, revert to traditional
        #
        print STDERR "unable to write to stderr,stdout - reverting to log files\n";
        $stderr_fn='logs/error.log';
        $stdout_fn='logs/access.log';
    }


    
    #  Might as well keep for reference
    #
    if (my $out = qx{bash -c 'ulimit -c unlimited 2>&1'}) {
        my $rc  = $? >> 8;
        if ($rc != 0) {
            print STDERR "unable alter ulimit, stubbing Apache::TestRun::ulimit\n";
            no warnings qw(once redefine);
            *Apache::TestRun::set_ulimit=sub {};
        }
    }
    
    
    #  Running on Mac ? Need to load mod_rewrite manually.
    #
    my $module_load_rewrite='';
    if ($^O eq 'darwin') {
        my $apxs = $ENV{APXS} || $ENV{APACHE_TEST_APXS} || 'apxs';
        my $libexecdir = qx{"$apxs" -q 'libexecdir' 2>/dev/null};
        die "Unable to query 'libexecdir' using $apxs\n" if $? != 0;
        chomp $libexecdir;
        $module_load_rewrite= <<"END"
<IfModule !rewrite_module>
    LoadModule rewrite_module $libexecdir/mod_rewrite.so
</IfModule>
END
        ;        
    }
    
    
    #  Get any additional library paths we want
    #
    my @perl_inc_dn=@{&perl_inc_dn()};


    #  Ok - proceed to build postamble
    #
    my $default_index_fn=File::Spec->rel2abs($WEBDYNE_DEFAULT_INDEX_FN || File::Spec->catfile($document_root, 'index.psp'));
    my $default_index_dn=dirname($default_index_fn);
    my @PerlSetEnv=map { sprintf('PerlSetEnv %s %s', $_, $ENV{$_}) } grep { /^WEBDYNE_/ } keys %ENV;
    push (@PerlSetEnv, sprintf('PerlSetEnv DOCUMENT_ROOT %s', $opt_hr->{'root_pn'})) if  $opt_hr->{'root_pn'};
    push (@PerlSetEnv, "PerlSetEnv WEBDYNE_ERROR_TEXT 1") unless defined($ENV{'WEBDYNE_ERROR_TEXT'});
    my $PerlSetEnv=join("\n", @PerlSetEnv);
    my $PerlSwitches=join("\n", map { sprintf('PerlSwitches -I%s', $_) } @perl_inc_dn);
    my $postamble= <<"END"
$module_load_rewrite
$PerlSetEnv
$PerlSwitches
PerlModule WebDyne
AddHandler modperl .psp
PerlResponseHandler WebDyne
PerlSetEnv DOCUMENT_DEFAULT $default_index_fn
#PerlOptions +GlobalRequest

ErrorLog $stderr_fn
LogLevel debug
CustomLog $stdout_fn combined

DirectoryIndex index.psp
Alias /index.psp $default_index_fn
AliasMatch ^/(.+)/index\.psp\$ $default_index_fn


<Directory "$default_index_dn">
    Require all granted
</Directory>
RewriteEngine On
RewriteCond %{REQUEST_URI} !^\Q/index.psp\E\$
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ /index.psp [L,PT]

<Directory "$document_root">
    Require all granted
</Directory>
END
    ;
    exit print $postamble if $opt_hr->{'dump_postamble'};
    return $postamble;
}


sub perl_inc_dn0 {

    my @lib;
    if (($^O ne 'MSWin32') && (-r (my $proc_fn='/proc/self/cmdline'))) {
        my $proc_fh=IO::File->new($proc_fn, O_RDONLY) || return;
        my @arg;
        local $/;
        my $proc=<$proc_fh>;
        $proc_fh->close();
        if (defined($proc) && $proc) {
            @arg=split(/\0/, $proc);
        }
        @lib=map { File::Spec->rel2abs(substr($_,2)) } (grep { /^-I/ } @arg);
    }
    return \@lib;
}


__END__

=begin markdown

# NAME

webdyne.apache - start a temporary Apache mod_perl instance for serving WebDyne pages

# SYNOPSIS

`webdyne.apache [--option] [document_root]`

`webdyne.apache --port 8080 /var/www/html`

`webdyne.apache --test`

`webdyne.apache /var/www/html/time.psp`

# DESCRIPTION

`webdyne.apache` starts a temporary Apache instance using `Apache::TestRunPerl` and configures it to handle `.psp` files with the WebDyne response handler. It is intended as a quick way to run WebDyne pages under Apache for local development, prototyping, and troubleshooting without doing a full Apache installation or system-wide configuration step first.

By default the script:

- uses the current working directory as the document root
- enables WebDyne index handling
- listens on port `5000`
- creates a temporary Apache server root
- creates a temporary WebDyne cache directory under that server root
- starts Apache in one-process mode and then waits until interrupted

If the supplied root is a file rather than a directory, the parent directory becomes Apache `DocumentRoot` and the selected file is passed through to WebDyne as `DOCUMENT_ROOT` so that a single-page application can be served.

This utility is primarily designed for quick prototyping and development under Apache. For a fuller Apache installation intended for ongoing or production-style deployment, use `bin/wdapacheinit` instead.

# OPTIONS

* **--index**

    Enable index handling. This is on by default. If enabled with the default value, WebDyne uses its internal default index page.

* **--noindex**

    Disable index handling.

* **--root | --docroot | --doc_root | --document_root**

    Specify the document root directory or a single `.psp` file to serve.

* **--port**

    Specify the Apache listen port. The default is `5000`.

* **--keep_tmp**

    Keep the temporary Apache server root instead of cleaning it up automatically on exit.

* **--test**

    Use the internal WebDyne test page as the root page.

* **--dump_postamble**

    Print the generated Apache configuration postamble and exit instead of starting the server.

* **--argv**

    Accepted by the script option parser, but not otherwise used by the current code.

* **--help | -?**

    Display a brief help message and exit.

# BEHAVIOUR

The generated Apache configuration currently does the following:

- loads the `WebDyne` Perl module
- installs `mod_perl` handling for `.psp` files with `PerlResponseHandler WebDyne`
- sets `DOCUMENT_DEFAULT` to the resolved WebDyne default index page
- passes through any current `WEBDYNE_*` environment variables as `PerlSetEnv`
- sets `WEBDYNE_ERROR_TEXT=1` unless already defined
- grants access to both the resolved default index directory and the selected document root
- sets `DirectoryIndex index.psp`
- aliases `/index.psp` to the resolved default index file
- rewrites directory requests to `/index.psp`
- logs to `/dev/stderr` and `/dev/stdout` where possible, otherwise falls back to Apache log files

The script also reads defaults from `~/.webdyne.apache.opt` if that file exists.

# EXAMPLES

Start Apache in the current directory on the default port:

```sh
webdyne.apache
```

Serve files from a specific directory:

```sh
webdyne.apache /var/www/html
```

Serve a single WebDyne page:

```sh
webdyne.apache /var/www/html/time.psp
```

Run on another port and keep the temporary Apache tree for inspection:

```sh
webdyne.apache --port 8080 --keep_tmp /var/www/html
```

Show the generated Apache configuration instead of starting the server:

```sh
webdyne.apache --dump_postamble /var/www/html
```

Start using the internal test page:

```sh
webdyne.apache --test
```

# NOTES

This script is a development helper, not a full Apache installation tool. It starts Apache using `Apache::Test` infrastructure in one-process mode, which is convenient for local testing but is not a substitute for a proper Apache deployment.

For production or more complete Apache setup, prefer `bin/wdapacheinit`, which is intended for installing Apache configuration more formally.

If you want to use `webdyne.apache`, additional system and CPAN tooling may need to be installed first. These components are not nominated by default in the WebDyne module:

- system packages for Apache HTTP Server
- `mod_perl`
- `mod_perl-dev` or the equivalent development package on your platform
- Perl CPAN modules `Apache::Test`
- Perl CPAN modules `Module::CoreList`

The script also checks for `Apache2::Build` at startup. If `Module::CoreList` is broken or outdated relative to the installed `Apache2::Build`, startup can fail with a message requesting rebuild or upgrade of `Module::CoreList`.

The Apache configuration generated by this script is assembled dynamically. Use `--dump_postamble` if you need to inspect the exact config fragment before startup.

The process stays in the foreground and exits on `INT` or `TERM`, at which point it attempts to stop the temporary Apache server cleanly.

# AUTHOR

Andrew Speer <andrew.speer@isolutions.com.au>

# LICENSE and COPYRIGHT

This file is part of WebDyne.

This software is copyright (c) 2026 by Andrew Speer <andrew.speer@isolutions.com.au>.

This is free software; you can redistribute it and/or modify it under
the same terms as the Perl 5 programming language system itself.

Full license text is available at:

<http://dev.perl.org/licenses/>

=end markdown


=head1 NAME

webdyne.apache - start a temporary Apache mod_perl instance for serving WebDyne pages


=head1 SYNOPSIS

C<webdyne.apache [--option] [document_root]>

C<webdyne.apache --port 8080 /var/www/html>

C<webdyne.apache --test>

C<webdyne.apache /var/www/html/time.psp>


=head1 DESCRIPTION

C<webdyne.apache> starts a temporary Apache instance using C<Apache::TestRunPerl> and configures it to handle C<.psp> files with the WebDyne response handler. It is intended as a quick way to run WebDyne pages under Apache for local development, prototyping, and troubleshooting without doing a full Apache installation or system-wide configuration step first.

By default the script:

=over

=item -

uses the current working directory as the document root


=item -

enables WebDyne index handling


=item -

listens on port C<5000>


=item -

creates a temporary Apache server root


=item -

creates a temporary WebDyne cache directory under that server root


=item -

starts Apache in one-process mode and then waits until interrupted


=back

If the supplied root is a file rather than a directory, the parent directory becomes Apache C<DocumentRoot> and the selected file is passed through to WebDyne as C<DOCUMENT_ROOT> so that a single-page application can be served.

This utility is primarily designed for quick prototyping and development under Apache. For a fuller Apache installation intended for ongoing or production-style deployment, use C<bin/wdapacheinit> instead.


=head1 OPTIONS

=over

=item *

B<--index>

Enable index handling. This is on by default. If enabled with the default value, WebDyne uses its internal default index page.



=item *

B<--noindex>

Disable index handling.



=item *

B<--root | --docroot | --doc_root | --document_root>

Specify the document root directory or a single C<.psp> file to serve.



=item *

B<--port>

Specify the Apache listen port. The default is C<5000>.



=item *

B<--keep_tmp>

Keep the temporary Apache server root instead of cleaning it up automatically on exit.



=item *

B<--test>

Use the internal WebDyne test page as the root page.



=item *

B<--dump_postamble>

Print the generated Apache configuration postamble and exit instead of starting the server.



=item *

B<--argv>

Accepted by the script option parser, but not otherwise used by the current code.



=item *

B<--help | -?>

Display a brief help message and exit.



=back


=head1 BEHAVIOUR

The generated Apache configuration currently does the following:

=over

=item -

loads the C<WebDyne> Perl module


=item -

installs C<mod_perl> handling for C<.psp> files with C<PerlResponseHandler WebDyne>


=item -

sets C<DOCUMENT_DEFAULT> to the resolved WebDyne default index page


=item -

passes through any current C<WEBDYNE_*> environment variables as C<PerlSetEnv>


=item -

sets C<WEBDYNE_ERROR_TEXT=1> unless already defined


=item -

grants access to both the resolved default index directory and the selected document root


=item -

sets C<DirectoryIndex index.psp>


=item -

aliases C</index.psp> to the resolved default index file


=item -

rewrites directory requests to C</index.psp>


=item -

logs to C</dev/stderr> and C</dev/stdout> where possible, otherwise falls back to Apache log files


=back

The script also reads defaults from C<~/.webdyne.apache.opt> if that file exists.


=head1 EXAMPLES

Start Apache in the current directory on the default port:


 webdyne.apache
Serve files from a specific directory:


 webdyne.apache /var/www/html
Serve a single WebDyne page:


 webdyne.apache /var/www/html/time.psp
Run on another port and keep the temporary Apache tree for inspection:


 webdyne.apache --port 8080 --keep_tmp /var/www/html
Show the generated Apache configuration instead of starting the server:


 webdyne.apache --dump_postamble /var/www/html
Start using the internal test page:


 webdyne.apache --test

=head1 NOTES

This script is a development helper, not a full Apache installation tool. It starts Apache using C<Apache::Test> infrastructure in one-process mode, which is convenient for local testing but is not a substitute for a proper Apache deployment.

For production or more complete Apache setup, prefer C<bin/wdapacheinit>, which is intended for installing Apache configuration more formally.

If you want to use C<webdyne.apache>, additional system and CPAN tooling may need to be installed first. These components are not nominated by default in the WebDyne module:

=over

=item -

system packages for Apache HTTP Server


=item -

C<mod_perl>


=item -

C<mod_perl-dev> or the equivalent development package on your platform


=item -

Perl CPAN modules C<Apache::Test>


=item -

Perl CPAN modules C<Module::CoreList>


=back

The script also checks for C<Apache2::Build> at startup. If C<Module::CoreList> is broken or outdated relative to the installed C<Apache2::Build>, startup can fail with a message requesting rebuild or upgrade of C<Module::CoreList>.

The Apache configuration generated by this script is assembled dynamically. Use C<--dump_postamble> if you need to inspect the exact config fragment before startup.

The process stays in the foreground and exits on C<INT> or C<TERM>, at which point it attempts to stop the temporary Apache server cleanly.


