#  Pragma
#
use strict;
use vars   qw($VERSION);
use warnings;
no warnings qw(redefine once);


#  External modules
#
use Cwd qw(fastcwd);
use Data::Dumper;
use File::Basename;
use File::Spec;


#  PAGI modules we need
#
use PAGI::Middleware::Builder;
use WebDyne::PAGI;
use WebDyne::Constant;
use WebDyne::PAGI::Constant;


#  Version Info, must be all one line for MakeMaker, CPAN.
#
$VERSION='2.087_619';


#  Check for supporting modules
#
BEGIN {
    my @missing;
    for my $module (qw(PAGI)) {
        eval "require $module; 1" or push @missing, $module;
    }
    if (@missing) {
        printf STDERR ("Please install missing CPAN modules: %s \n", join(', ', @missing));
        exit 1;
    }
    
}


#  Called from command line ?
#
if (!caller || exists $ENV{PAR_TEMP}) {


    #  Yes. Get options
    #
    my %opt=(
        test    => 0,
        static  => 1,
        index   => 1,
        %{do(glob(sprintf('~/.%s.opt', basename(__FILE__)))) || {}}
    );


    #  Process
    #
    require Getopt::Long;
    Getopt::Long::Configure('pass_through');
    Getopt::Long::GetOptions(
        \%opt,
        'test!',
        'static!',
        'index!',
        'root:s',
        'argv:s'
    );
    
    
    #  Last argument is root directory
    #
    if (@ARGV && $ARGV[-1] !~ /^--?/) {
        $opt{'root'} = pop @ARGV;
    }
    else {
        $opt{'root'} ||=($ENV{'DOCUMENT_ROOT'} ||  fastcwd());
    }
    
    
    #  Startup
    #
    exit &startup(\%opt, split(/\s+/, $opt{'argv'} || ''), @ARGV);

}
else {

    # No - called from pagi_server. Need document root and doc default from 
    # env or var
    #
    my %opt=(
        root    => $ENV{'DOCUMENT_ROOT'} || $DOCUMENT_ROOT || fastcwd(),
        index   => $ENV{'DOCUMENT_DEFAULT'} || $DOCUMENT_DEFAULT
    );
    return &build(\%opt);
    
}



#==================================================================================================


sub build {


    #  Build app code ref, options passed for builder
    #
    my $opt_hr=shift();
    my $builder_or=PAGI::Middleware::Builder->new();
    
    
    #  Adjust static service config var based on opts if
    #  they exist
    #
    if (exists($opt_hr->{'static'})) {
        $WEBDYNE_PAGI_STATIC=$opt_hr->{'static'};
    }
    
    
    #  Add in any middleware in config file
    #
    foreach my $middleware_ar (@{$WEBDYNE_PAGI_MIDDLEWARE}) {
        my ($middleware, $middleware_opt_hr)=@{$middleware_ar};
        
        #  Skip static if not wanted
        #
        if ($middleware eq 'Static') {
            next unless $WEBDYNE_PAGI_STATIC;
        }
        
        
        #  And code refs are run and given opt as first param
        #
        if (ref($middleware_opt_hr) eq 'CODE') {
            $middleware_opt_hr=$middleware_opt_hr->($opt_hr);
        }
        
        
        #  Now add it
        #
        $builder_or->add_middleware($middleware, %{$middleware_opt_hr});
    }
    

    #  Read in local webdyne.conf.pl
    #
    #&local_constant_load($opt_hr->{'root'});


    #  Finally return as app code ref
    #
    return $builder_or->to_app(
        WebDyne::PAGI->new(%{$opt_hr})->to_app())

}


sub startup {


    #  Get WebDyne::PAGI options and PAGI::Runner args
    #
    my ($opt_hr, @argv)=@_;
    
    
    #  Running from command line without being stared by plackup or starman
    #
    require PAGI::Runner;
    my $pagi_or=PAGI::Runner->new();
    
    
    #  Add host 0.0.0.0 option unless already spec'd as option
    #
    push (@argv, ('--host', '0.0.0.0')) unless grep { /--host/ } @argv;
    

    #  Mac conflicts with Plack default port of 5000 - choose 5001
    #
    if ($^O eq 'darwin') {
        $pagi_or->parse_options('--port', '5001', @argv) unless grep { /--port/ } @argv
    }
    else {
        $pagi_or->parse_options(@argv);
    }
    

    #  Read in local webdyne.conf.pl
    #
    &local_constant_load($opt_hr->{'root'});


    #  Get app code ref from WebDyne::PAGI
    #
    my $app_cr=&build($opt_hr);

    
    #  Run it
    #
    *PAGI::Runner::load_app=sub { return $app_cr };
    exit $pagi_or->run();

}


sub local_constant_load {


    #  Read in local webdyne.conf.pl
    #
    my $root_dn=shift();
    
    
    #  If root_dn is a file get dir name
    #
    if (-f $root_dn) {
        $root_dn=(File::Spec->splitpath($root_dn))[1];
    }
    WebDyne::Constant->import(File::Spec->catfile($root_dn, sprintf('.%s', $WEBDYNE_CONF_FN)));

}


__END__
sub normalize_dn {

    #  Normal dir, normally document_root
    #
    my $rel_dn=shift();
    my $abs_dn=File::Spec->rel2abs($rel_dn);
    $abs_dn =~ s{/$}{} unless $abs_dn eq '/';
    return $abs_dn;
    
}






=head1 NAME

WebDyne - PAGI application for handling web requests


=head1 SYNOPSIS

C<<< webdyne.pagi [--option] <document_root> >>>

C<webdyne.pagi --port 8080 /var/www/html>

C<webdyne.pagi --test>


=head1 DESCRIPTION

C<webdyne.pagi> is a PAGI application script that handles web requests using the WebDyne framework. It builds a C<WebDyne::PAGI> application, loads any configured PAGI middleware, and starts it through C<PAGI::Runner>.

The underlying C<WebDyne::PAGI> application can dispatch PAGI scope types for normal HTTP requests, server-sent events, WebSocket connections, and lifespan startup or shutdown events.


=head1 OPTIONS

C<webdyne.pagi> parses a small set of wrapper options itself and passes remaining command line options through to C<PAGI::Runner>.

Wrapper options handled by C<webdyne.pagi> itself:

B<--test> Use WebDyne's internal test page as the root.

B<--static / --nostatic> Enable or disable PAGI static-file middleware.

B<--index / --noindex> Enable or disable index handling. With the default enabled setting, the wrapper maps the index document to WebDyne's internal default index page.

B<--root> Set the document root.

B<--argv> Supply additional arguments that the wrapper will prepend before invoking C<PAGI::Runner>.

Remaining command line options are handled by C<PAGI::Runner>. Some common options are:

B<-o, --host> Which host interface to bind to. When launched through C<webdyne.pagi>, the wrapper adds C<--host 0.0.0.0> unless you specify a host explicitly.

B<-p, --port> Which port to bind to.

B<-s, --server> Which PAGI server class to use. The runner default is C<PAGI::Server>.

B<-E, --env> Environment mode, for example C<development>, C<production>, or C<none>.

B<-l, --loop> Event loop backend.

B<-I, --lib> Add a library path to C<@INC>.

B<-M> Load a module before the app starts.

B<--default-middleware / --no-default-middleware> Enable or disable runner default middleware.

B<-D, --daemonize> Run as a background daemon.

B<--access-log / --no-access-log> Configure access logging.

B<--pid, --user, --group, -q, --quiet, -v, --version, --help> Standard runner process and output controls.


=head1 EXAMPLES

To run the script for basic functionality and serve files from C</var/www/html>, use:

C<webdyne.pagi /var/www/html>

Disable wrapper-managed index handling and rely on the PAGI request layer's default document behaviour instead:

C<webdyne.pagi --noindex /var/www/html>

Start on another port:

C<webdyne.pagi --port 8080 /var/www/html>

Start with a specific host:

C<webdyne.pagi --host 127.0.0.1 --port 8080 /var/www/html>

Start with the internal test page:

C<webdyne.pagi --test>

Start with a different event loop backend:

C<webdyne.pagi --loop EV /home/aspeer/public_html>


=head1 ENVIRONMENT VARIABLES

This script is a frontend to the WebDyne PAGI stack. It uses WebDyne configuration and environment handling, including C<DOCUMENT_ROOT>, C<DOCUMENT_DEFAULT>, and the relevant C<WEBDYNE_*> settings used by the PAGI modules.

When launched from the command line, the wrapper also reads local WebDyne configuration from C<DOCUMENT_ROOT/.webdyne.conf.pl> before starting the PAGI runner.

Relevant PAGI-specific settings from C<WebDyne::PAGI::Constant> include:

B<WEBDYNE_PAGI_STATIC> Enable or disable static-file serving middleware.

B<WEBDYNE_PAGI_MIDDLEWARE_STATIC> Regular expression used to decide which static files are served directly.

B<WEBDYNE_PAGI_MIDDLEWARE> Middleware stack applied around the WebDyne PAGI app.

B<WEBDYNE_PAGI_ENV_KEEP / WEBDYNE_PAGI_ENV_SET> Environment variables preserved or injected for request handling.


